# Anthropic (powers the Bull / Bear / Risk Manager / Decision agents)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Which LLM backend powers the agents: "anthropic" or "groq"
# Use "groq" for free testing (no card required, console.groq.com),
# switch to "anthropic" for the real submission — Claude's reasoning
# quality is noticeably better for the actual demo.
LLM_PROVIDER=anthropic

# Only needed if LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here

# Alpaca Trading API (https://app.alpaca.markets/paper/dashboard/overview)
ALPACA_API_KEY=your_alpaca_key_id_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# Keep this true for the hackathon — never point at live trading in a demo
ALPACA_PAPER=true
